# ==========================================
# PillSync Backend - Environment Variables Template
# Phase 1 Configuration
# ==========================================

ENVIRONMENT=development
PROJECT_NAME="PillSync API"
VERSION="0.1.0"
LOG_LEVEL=INFO

BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myproject
DB_USER=postgres
DB_PASSWORD=your_postgresql_password

# JWT Security (Required - generate a strong random secret in production)
JWT_SECRET_KEY=replace_with_a_real_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google SMTP Email Verification (Generate App Password at: https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
SMTP_FROM_EMAIL=your_gmail_address@gmail.com
SMTP_FROM_NAME="PillSync"
SMTP_TLS=true
EMAIL_OTP_EXPIRE_MINUTES=10
