# ==========================================
# PillSync Backend - Environment Variables Template
# Phase 1 Configuration
# ==========================================

ENVIRONMENT=development
PROJECT_NAME="PillSync API"
VERSION="0.1.0"
LOG_LEVEL=INFO

BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myproject
DB_USER=postgres
DB_PASSWORD=your_postgresql_password

# JWT Security (Required - generate a strong random secret in production)
JWT_SECRET_KEY=replace_with_a_real_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Brevo HTTP API Email Configuration (Recommended for Production & Render)
# Generate API key at: https://app.brevo.com/settings/keys/api (Key prefix: xkeysib-)
BREVO_API_KEY=xkeysib-your_brevo_api_v3_key_here
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_FROM_EMAIL=verified_sender@yourdomain.com
BREVO_FROM_NAME="PillSync"
BREVO_TIMEOUT_SECONDS=15.0

# Optional Local Development SMTP (Used only if BREVO_API_KEY is not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
SMTP_FROM_EMAIL=your_gmail_address@gmail.com
SMTP_FROM_NAME="PillSync"
SMTP_TLS=true
EMAIL_OTP_EXPIRE_MINUTES=10

